FROM node:24-bookworm-slim AS manifests
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY services/package.json services/package.json

FROM manifests AS web-build
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
RUN npm ci --workspace @docuscripter/web
COPY apps/web apps/web
RUN npm run build

FROM caddy:2.11-alpine AS web
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /app/apps/web/dist /srv

FROM manifests AS service
ENV NODE_ENV=production HOST=0.0.0.0
RUN npm ci --workspace @docuscripter/services --omit=dev
COPY --chown=node:node services services
USER node
