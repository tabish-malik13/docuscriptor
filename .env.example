VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Generate three DIFFERENT secrets: openssl rand -hex 32 (run once for each).
# These are server-only. Never prefix them with VITE_.
DOCX_SERVICE_SECRET=
PDF_SERVICE_SECRET=
GOTENBERG_PASSWORD=

# For Vite development against the full Compose stack:
# DEV_GATEWAY_URL=http://127.0.0.1:4173

# Optional container-reachable URL when Supabase runs on the local host.
# SUPABASE_GATEWAY_URL=http://host.docker.internal:54321

# Native development: central account page and organization workspace addresses.
VITE_APP_ORIGIN=http://127.0.0.1:5173
VITE_ORGANIZATION_BASE_DOMAIN=docuscriptor.localhost

# Production Compose deployment (requires wildcard DNS and HTTPS ingress).
# PUBLIC_APP_ORIGIN=https://docuscriptor.com
# PUBLIC_ORGANIZATION_BASE_DOMAIN=docuscriptor.com

# Free provider hostname: use the actual Pages project address.
# PUBLIC_APP_ORIGIN=https://docuscriptor.pages.dev
# PUBLIC_ORGANIZATION_ROUTING=path
# VITE_ORGANIZATION_ROUTING=path  # optional native path-mode development

# Native frontend flag; Pages derives it from PUBLIC_PROCESSOR_ENABLED.
# VITE_PROCESSING_ENABLED=false

# Enable processing in the Pages build only after the Render gateway is healthy.
# PUBLIC_PROCESSOR_ENABLED=true
# PROCESSOR_ORIGIN=https://<service>.onrender.com  # also set as a Pages runtime variable
