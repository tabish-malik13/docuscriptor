VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Generate three DIFFERENT secrets: openssl rand -hex 32 (run once for each).
# These are server-only. Never prefix them with VITE_.
DOCX_SERVICE_SECRET=
PDF_SERVICE_SECRET=
GOTENBERG_PASSWORD=

# Optional local SQLite database path (default: .data/workspace.sqlite).
# DATA_PATH=/absolute/path/workspace.sqlite

# For Vite development against the full Compose stack:
# DEV_GATEWAY_URL=http://127.0.0.1:4173

# Optional container-reachable URL when Supabase runs on the local host.
# SUPABASE_GATEWAY_URL=http://host.docker.internal:54321

# Native development: central account page and organization workspace addresses.
VITE_APP_ORIGIN=http://127.0.0.1:5173
VITE_ORGANIZATION_BASE_DOMAIN=docuscriptor.localhost

# Production Compose deployment (requires wildcard DNS and HTTPS ingress).
# PUBLIC_APP_ORIGIN=https://docuscriptor.com
# PUBLIC_ORGANIZATION_BASE_DOMAIN=docuscriptor.com

# Free provider hostname: use the actual Pages project address.
# PUBLIC_APP_ORIGIN=https://docuscriptor.pages.dev
# PUBLIC_ORGANIZATION_ROUTING=path
# VITE_ORGANIZATION_ROUTING=path  # optional native path-mode development

# Gateway limits. See docs/rate-limits.md for proxy and quota behavior.
# RATE_LIMIT_IP_PER_MINUTE=120
# RATE_LIMIT_TOKEN_PER_MINUTE=20
# RATE_LIMIT_WEBHOOK_PER_MINUTE=120
# RATE_LIMIT_SUBJECT_PER_MINUTE=120
# RATE_LIMIT_TENANT_PER_MINUTE=600
# RATE_LIMIT_WRITE_PER_MINUTE=20
# RATE_LIMIT_TENANT_WRITE_PER_MINUTE=60
# RATE_LIMIT_TRUSTED_PROXIES=
# TENANT_PROCESSING_CONCURRENCY=2

# Owners and admins can set up WhatsApp in Organization settings. By default
# the gateway generates a private encryption key on its persistent data volume.
# Optionally provide a stable 32-byte base64 key, generated with openssl rand -base64 32.
# WHATSAPP_ENCRYPTION_KEY=
# Optional deployment-managed WhatsApp bindings. See docs/whatsapp.md.
# WHATSAPP_CONFIG_FILE=/absolute/path/to/whatsapp.json

# Organization billing is optional. See docs/billing.md. Use only gateway variables.
BILLING_MODE=self-hosted
# BILLING_LICENSES_FILE=/absolute/path/to/licenses.json
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_ULTIMATE_PRICE_ID=
RAZORPAY_BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLUS_PLAN_ID=
RAZORPAY_ULTIMATE_PLAN_ID=
RAZORPAY_TOTAL_COUNT=
